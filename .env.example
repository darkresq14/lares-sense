# radar_persist.py configuration template — copy to .env and fill in.
# Resolution order: CLI argument > environment variable > .env > default.
# .env is gitignored; keep credentials out of git.

# PostgreSQL DSN of the TimescaleDB server (required, from some layer).
DATABASE_URL=postgresql://user:password@localhost:5432/lares

# UDP port the Pi's radar_sender.py streams frames to.
RADAR_PORT=5005

# Local network interface to listen on: 0.0.0.0 = every interface,
# 127.0.0.1 = local traffic only.
RADAR_BIND=0.0.0.0

# Rows per INSERT transaction (write batching).
RADAR_BATCH_SIZE=50

# Max seconds a received frame may wait in the write buffer.
RADAR_FLUSH_INTERVAL=1.0
